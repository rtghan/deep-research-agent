# Copy to .env and fill in. .env is gitignored.

# --- LLM provider: pick ONE path ---

# Path A: OpenAI directly (used by configs/default.yaml)
OPENAI_API_KEY=sk-...

# Path B: OpenRouter (used by configs/openrouter.yaml, run with --openrouter)
# Lets the extractor and the adversarial challenger sit on different model
# families through a single key -- see DECISIONS.md D021/D026.
OPENROUTER_API_KEY=sk-or-v1-...

# --- Web search (optional) ---
# Without a Tavily key the system falls back to DuckDuckGo + Wikipedia, which
# need no key. arXiv is always available and needs no key.
SEARCH_BACKEND=auto        # auto | tavily | duckduckgo | wikipedia
TAVILY_API_KEY=
